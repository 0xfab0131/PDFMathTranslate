# Reference template for local secrets.
# The practical local file is the repository-root `.env`.
#
# Copy this file to `.env` and fill in the real values there.
#
# Main production path for mathematical papers:
# - docker-compose.yml
# - config/pdf2zh_next.openai.toml
#
# The application reads these environment variables and they override the tracked TOML file.
# This keeps secrets out of Git while still letting the GUI use the configured values.

# ---------- Required for the OpenAI production path ----------
PDF2ZH_OPENAI_API_KEY=sk-your-real-openai-api-key-here

# ---------- Usually keep these unless you know you need different values ----------
PDF2ZH_OPENAI_BASE_URL=https://api.openai.com/v1
PDF2ZH_OPENAI_MODEL=gpt-4.1-mini
PDF2ZH_OPENAI_TIMEOUT=500
PDF2ZH_OPENAI_TEMPERATURE=0.0
PDF2ZH_OPENAI_ENABLE_JSON_MODE=true
PDF2ZH_OPENAI_SEND_TEMPRATURE=true

# ---------- Optional later, for Ollama comparison ----------
# For Docker Desktop on the same host:
# PDF2ZH_OLLAMA_HOST=http://host.docker.internal:11434
# PDF2ZH_OLLAMA_MODEL=gemma2

# ---------- Optional only if your environment has asset download issues ----------
# HF_ENDPOINT=https://hf-mirror.com
